<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:vmPing.Properties"
        xmlns:classes="clr-namespace:vmPing.Classes"
        x:Class="vmPing.UI.FloodHostWindow"
        x:DataType="classes:FloodHostNode"
        Title="{x:Static p:Strings.FloodHost_WindowTitle}"
        Width="400" Height="250"
        CanResize="False"
        Background="#002b36">

    <!--
        FASE 4 — port funcional-primeiro de UI/FloodHostWindow.xaml original
        (223+107 linhas). Simplificações deliberadas:
          - Animação de cor de fundo pulsando enquanto o flood está ativo
            (ColorAnimation em Window.Style/DataTrigger) -> não portada
            (cosmético, Fase 5); a janela fica com a cor estática de sempre.
          - Ícone do botão (BooleanToImageConverter) -> só o texto "Flood
            Host"/"Stop Flood" (mesmo padrão já usado em TraceRouteWindow).
          - Texto de status "Flood in progress..." piscando (Storyboard) ->
            texto estático, sem pisca-pisca.
          - ControlTemplate customizado do TextBox -> TextBox padrão do
            Avalonia (não tinha placeholder mesmo no original, só bordas
            customizadas).
        Classes/FloodHostNode.cs já tinha sido portado na Fase 2 sem alteração
        (já era `public class`, ao contrário de NetworkRoute/NetworkRouteNode
        em TraceRouteWindow — não precisou de correção de visibilidade aqui).
    -->

    <Window.Resources>
        <classes:BoolToStringConverter x:Key="BoolToStringConverter" TrueValue="{x:Static p:Strings.FloodHost_Stop}" FalseValue="{x:Static p:Strings.FloodHost_Start}" />
        <classes:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <!-- FASE 5 (rodada 3) — as duas animações adiadas na Fase 4, portadas com
         Style.Animations (keyframes nativos do Avalonia) em vez de Storyboard:
           - Pulso de fundo enquanto o flood roda: o original animava a cor do
             Background da janela (ColorAnimation). Aqui: um Border overlay
             (PulseOverlay) vermelho com IsHitTestVisible=False, visível só com
             IsActive, opacidade pulsando 0 -> 0.14 -> 0. Animar double
             (Opacity) é o caminho mais garantido — interpolar cor de Brush é
             menos verificado.
           - "Flood in progress..." piscando: opacidade 1 -> 0.25 -> 1. -->
    <Window.Styles>
        <Style Selector="Border#PulseOverlay">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.14" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock#StatusText">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Panel>
    <Border Name="PulseOverlay" Background="#dc322f" IsHitTestVisible="False"
            ZIndex="1" IsVisible="{Binding IsActive}" />
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBox Name="Hostname" Grid.Column="0"
                     FontSize="18" FontWeight="Bold"
                     BorderThickness="2" BorderBrush="Black"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}" />

            <Button Name="FloodHost" Grid.Column="1" Click="FloodHost_Click" IsDefault="True"
                    FontSize="14" Padding="0,6" MinWidth="125" Margin="6,0,0,0"
                    Background="#268bd2" Foreground="White"
                    Content="{Binding IsActive, Converter={StaticResource BoolToStringConverter}}" />
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="2">
            <StackPanel VerticalAlignment="Center">
                <Grid ColumnDefinitions="*,*" Margin="0,4">
                    <TextBlock Grid.Column="0" Text="{x:Static p:Strings.FloodHost_Sent}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,15,0" Foreground="#93a1a1" FontSize="16" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding PacketsSent, StringFormat='{}{0:#,0}'}" Foreground="#859900" FontSize="22" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="0,4">
                    <TextBlock Grid.Column="0" Text="{x:Static p:Strings.FloodHost_Received}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,15,0" Foreground="#93a1a1" FontSize="16" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding PacketsReceived, StringFormat='{}{0:#,0}'}" Foreground="#6c71c4" FontSize="22" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="0,4">
                    <TextBlock Grid.Column="0" Text="{x:Static p:Strings.FloodHost_Lost}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,15,0" Foreground="#93a1a1" FontSize="16" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding PacketsLost, StringFormat='{}{0:#,0}'}" Foreground="#dc322f" FontSize="22" />
                </Grid>
            </StackPanel>

            <Border Name="InformationOverlay" Background="#002b36">
                <TextBlock TextWrapping="Wrap" TextAlignment="Justify" Foreground="#657b83" FontSize="14"
                           Margin="40,0" VerticalAlignment="Center"
                           Text="{x:Static p:Strings.FloodHost_Info}" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Name="StatusText" Text="{x:Static p:Strings.FloodHost_InProgress}" Margin="0,7" HorizontalAlignment="Center"
                   Foreground="#657b83" FontSize="13" IsVisible="{Binding IsActive}" />
    </Grid>
    </Panel>
</Window>
