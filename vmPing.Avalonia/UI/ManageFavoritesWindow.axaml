<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:vmPing.Properties"
        x:Class="vmPing.UI.ManageFavoritesWindow"
        Title="{x:Static p:Strings.Menu_ManageFavorites}"
        Width="600" Height="475"
        MinWidth="425" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <!--
        FASE 4 — port funcional-primeiro de UI/ManageFavoritesWindow.xaml
        original (144 linhas). Usava DataGrid/ListBox com estilos customizados
        do WPF; aqui usa dois ListBox simples (Avalonia.Controls.DataGrid é um
        pacote separado — não adicionado sem necessidade real, ver disciplina
        de dependências no MIGRATION_PLAN.md). Hack de esconder
        minimizar/maximizar via user32.dll do original foi removido (Windows-only,
        sem equivalente/necessidade no Linux).
    -->
    <Grid Margin="9" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Menu_ManageFavorites}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="*,8,0.85*">
            <ListBox Name="Favorites" Grid.Column="0" SelectionChanged="Favorites_SelectionChanged" />

            <Border Grid.Column="2" Name="ContentsSection" IsVisible="False"
                    Background="#f4f4f4" BorderBrush="#abadb3" BorderThickness="1">
                <DockPanel>
                    <TextBlock Name="FavoriteTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Padding="5" />
                    <ListBox Name="Contents" FontFamily="monospace" Background="Transparent" />
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,9,0,0">
            <Button Content="{x:Static p:Strings.DialogButton_New}" MinWidth="85" Click="New_Click" VerticalAlignment="Center" />
            <Button Content="{x:Static p:Strings.DialogButton_Edit}" MinWidth="85" Click="Edit_Click" IsEnabled="{Binding #Favorites.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
            <Button Content="{x:Static p:Strings.DialogButton_Remove}" MinWidth="85" Click="Remove_Click" IsEnabled="{Binding #Favorites.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
