<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:vmPing.Properties"
        x:Class="vmPing.UI.DnsLookupWindow"
        Title="{x:Static p:Strings.DnsLookup_WindowTitle}"
        Width="620" Height="480"
        MinWidth="400" MinHeight="300"
        Background="#e1e1e1">

    <!--
        FASE 5 — janela NOVA (não existe no vmPing original), pedida pelo
        usuário: consultas nslookup e dig direto do menu, logo abaixo do
        Traceroute. Uma única janela parametrizada pela ferramenta
        (construtor recebe "nslookup" ou "dig") em vez de duas janelas quase
        idênticas. Mesmo padrão de shell-out da TraceRouteWindow: chama o
        utilitário do sistema e mostra a saída crua — pra dig, a saída crua
        É o produto; reformatar seria estragar. Dependência de pacote:
        bind9-dnsutils (registrada em packaging/debian/control); sem o
        utilitário instalado, o erro do Process.Start é mostrado na área de
        saída em vez de crashar (mesma lição do bug do Browse/portal).
    -->

    <DockPanel LastChildFill="True" Margin="15">
        <TextBlock Name="Header" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Foreground="#303030"
                   Margin="0,5,0,10" Text="{x:Static p:Strings.DnsLookup_WindowTitle}" />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <TextBox Name="Hostname" Grid.Column="0"
                     FontSize="18" Padding="6,4" FontFamily="monospace"
                     BorderThickness="1" BorderBrush="#303030"
                     VerticalContentAlignment="Center"
                     Watermark="{x:Static p:Strings.DnsLookup_Watermark}" />

            <Button Name="Run" Grid.Column="1" Click="Run_Click" IsDefault="True"
                    FontSize="14" Margin="10,0,0,0" MinWidth="110"
                    Content="{x:Static p:Strings.DnsLookup_Run}" />
        </Grid>

        <!-- Opções de consulta (pedido do usuário): tipo de registro,
             servidor DNS específico e flags do dig. As flags (+short/
             +answer) só existem no dig — no nslookup elas ficam ocultas
             (code-behind), o tipo vira -type=X e o servidor é posicional. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0" Spacing="12">
            <TextBlock Name="RecordTypeLabel" Text="{x:Static p:Strings.DnsLookup_Type}" VerticalAlignment="Center" />
            <ComboBox Name="RecordType" Width="110" VerticalAlignment="Center" />

            <TextBlock Text="{x:Static p:Strings.DnsLookup_Server}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox Name="Server" Width="150" FontFamily="monospace" VerticalAlignment="Center"
                     Watermark="@8.8.8.8" />

            <CheckBox Name="FlagShort" Content="+short" VerticalAlignment="Center" Margin="8,0,0,0" />
            <CheckBox Name="FlagAnswer" Content="+answer" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox Name="Output" Margin="0,15,0,0"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="monospace" FontSize="14"
                 Background="#202020" Foreground="#fdf6e3" BorderThickness="1" BorderBrush="Black" />
    </DockPanel>
</Window>
