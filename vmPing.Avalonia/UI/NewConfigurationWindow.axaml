<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:vmPing.Properties"
        x:Class="vmPing.UI.NewConfigurationWindow"
        Title="{x:Static p:Strings.NewConfig_WindowTitle}"
        Width="520"
        CanResize="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
        FASE 4 — port funcional-primeiro de UI/NewConfigurationWindow.xaml
        original. UI portada e pronta para uso, mas AINDA NÃO conectada a
        Classes/Configuration.IsReady() — ver comentário detalhado em
        Configuration.cs sobre por que isso exige tornar IsReady()/Save() (e
        toda a cadeia de chamadas que depende deles) assíncronos, uma mudança
        de arquitetura maior que fica para depois. Esta janela funciona
        isoladamente (ShowDialog&lt;bool&gt;) para quando essa cadeia for
        refeita.
    -->
    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="20" Spacing="6">
            <TextBlock TextWrapping="Wrap" FontSize="14"
                       Text="{x:Static p:Strings.NewConfig_Line1}" />
            <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10,0,1"
                       Text="{x:Static p:Strings.NewConfig_Line2}" />
            <TextBlock Name="FilePath" TextWrapping="Wrap" FontSize="12" Foreground="#268bd2" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,20,0,0"
                       Text="{x:Static p:Strings.NewConfig_Line3}" />
        </StackPanel>

        <Border Grid.Row="1" Background="#f0f0f0" BorderBrush="#dfdfdf" BorderThickness="0,1,0,0">
            <DockPanel Margin="10">
                <CheckBox Name="PortableMode" DockPanel.Dock="Left" Content="{x:Static p:Strings.NewConfig_Portable}" Click="PortableMode_Click" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button MinWidth="100" IsDefault="True" Content="{x:Static p:Strings.DialogButton_Save}" Click="Save_Click" VerticalAlignment="Center" />
                    <Button MinWidth="100" Content="{x:Static p:Strings.DialogButton_Cancel}" Click="Cancel_Click" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
