<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:vmPing.Properties"
        x:Class="vmPing.UI.OptionsWindow"
        Title="{x:Static p:Strings.Menu_Options}"
        Width="680" Height="560"
        MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#e1e1e1">

    <!--
        FASE 4 — port funcional-primeiro de UI/OptionsWindow.xaml original
        (898+931 linhas, a maior janela do app). Simplificações deliberadas,
        registradas em detalhe no docs/PORTING_NOTES.md:
          - Estilos nomeados (OptionHeaderTextStyle etc, vindos de
            ResourceDictionaries/*.xaml não portado) -> atributos inline em
            cada TextBlock, sem Window.Resources com Style — Avalonia não
            aplica Style por instância (Control.Style) do mesmo jeito que o
            WPF faz via StaticResource; o idiomático é Classes+Selector, que
            não valia a pena introduzir só pra ~10 elementos.
          - DllImport user32.dll pra esconder os botões minimizar/maximizar
            (SourceInitialized) -> não portado, Windows-only, sem
            equivalente/necessidade no Linux.
          - Todo DataTrigger de visibilidade condicional (baseado em
            ElementName+IsChecked/SelectedItem.Tag/Text.Length) -> resolvido
            no code-behind via handlers de evento (Click/Checked/
            SelectionChanged) alterando IsVisible diretamente, em vez de
            apostar na sintaxe de binding `{Binding #Nome.Prop}` sem
            x:DataType (ainda não confirmada contra um build real nesta
            sessão — ver risco registrado em ManageFavoritesWindow/
            ManageAliasesWindow). Dado o tamanho desta janela, prefiro não
            empilhar mais uma categoria de risco não verificado em cima.
          - Amostra de cor ao vivo (Border com Background bound ao texto do
            TextBox via StringToBrushConverter, 20 instâncias na aba Colors)
            -> não portada; mesma razão acima. As cores continuam
            validando/salvando/carregando corretamente, só perde o preview
            visual instantâneo (Fase 5).
          - Label com tooltip customizado (ícone + texto, estilo
            LabelToolTip não portado) -> ToolTip.Tip nativo do Avalonia
            direto no controle relevante.
          - PasswordBox (WPF) -> TextBox com PasswordChar, texto lido via
            .Text em vez de .Password/.SecurePassword.
          - FolderBrowserDialog/OpenFileDialog (System.Windows.Forms,
            Windows-only) -> IStorageProvider.OpenFolderPickerAsync/
            OpenFilePickerAsync (API do Avalonia 11.x). [Provável, NÃO
            verificado nesta sessão contra o código-fonte — a rede esteve
            indisponível quando fui checar. Se o build reclamar de
            FolderPickerOpenOptions/FilePickerOpenOptions/FilePickerFileType,
            é o primeiro lugar a olhar.]
          - PreviewTextInput pra bloquear caractere inválido enquanto digita
            (ping interval, TTL, cor HTML etc) -> não portado; a validação
            de verdade (Regex, faixa de valores) já acontece no Save e
            continua idêntica ao original — só perde o bloqueio em tempo
            real de tecla.
        Todas as 8 abas (General, Advanced, Notifications, Email, Sounds,
        Logging, Display, Colors) foram portadas com os campos e a lógica de
        validação reais do original.
    -->

    <Grid RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" TabStripPlacement="Left">

            <!-- Tab: General -->
            <TabItem Header="{x:Static p:Strings.Options_TabGeneral}" Name="GeneralTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,15,20,15">
                        <TextBlock Text="{x:Static p:Strings.Options_ProbeOptions}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" />

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <TextBlock Text="{x:Static p:Strings.Options_PingInterval}" MinWidth="110" VerticalAlignment="Center" />
                            <TextBox Name="PingInterval" Width="60" MaxLength="5" VerticalAlignment="Center" />
                            <ComboBox Name="PingIntervalUnits" MinWidth="110" Margin="10,0,0,0" SelectedIndex="0" VerticalAlignment="Center">
                                <ComboBoxItem Content="{x:Static p:Strings.Options_Seconds}" />
                                <ComboBoxItem Content="{x:Static p:Strings.Options_Minutes}" />
                                <ComboBoxItem Content="{x:Static p:Strings.Options_Hours}" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{x:Static p:Strings.Options_PingTimeout}" MinWidth="110" VerticalAlignment="Center" />
                            <TextBox Name="PingTimeout" Width="60" MaxLength="2" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Options_Seconds}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1" Background="#ccc" Margin="0,20,0,5" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{x:Static p:Strings.Options_AlertThreshold}" MinWidth="110" VerticalAlignment="Center" />
                            <TextBox Name="AlertThreshold" Width="60" MaxLength="2" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Options_DroppedPings}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{x:Static p:Strings.Options_Startup}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" Margin="0,25,0,10" />
                        <TextBlock Text="{x:Static p:Strings.Options_StartupPrompt}" Margin="0,0,0,5" />
                        <ComboBox Name="StartupMode" Width="200" HorizontalAlignment="Left" SelectionChanged="StartupMode_SelectionChanged">
                            <ComboBoxItem Content="{x:Static p:Strings.Options_StartBlank}" />
                            <ComboBoxItem Content="{x:Static p:Strings.Options_StartList}" />
                            <ComboBoxItem Content="{x:Static p:Strings.Options_StartFavorite}" />
                        </ComboBox>

                        <StackPanel Name="StandardStartupPanel" Orientation="Horizontal" Margin="0,13,0,0">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="{x:Static p:Strings.Options_ProbeCount}" Margin="0,0,0,4" VerticalAlignment="Center" />
                                <TextBox Name="InitialProbeCount" Width="60" HorizontalAlignment="Left" MaxLength="2" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Strings.Options_ColumnCount}" Margin="0,0,0,4" />
                                <TextBox Name="InitialColumnCount" Width="60" HorizontalAlignment="Left" MaxLength="2" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Name="FavoriteStartupPanel" Orientation="Horizontal" Margin="0,13,0,0" IsVisible="False">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Strings.Options_SelectFavorite}" Margin="0,0,0,4" VerticalAlignment="Center" />
                                <ComboBox Name="InitialFavorite" Width="250" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Advanced -->
            <TabItem Header="{x:Static p:Strings.Options_TabAdvanced}" Name="AdvancedTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,15,20,15">
                        <TextBlock Text="{x:Static p:Strings.Options_AdvancedIcmp}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" />

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <TextBlock Text="{x:Static p:Strings.Options_Ttl}" MinWidth="110" VerticalAlignment="Center" />
                            <TextBox Name="TTL" Width="80" MaxLength="3" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Options_Hops}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1" Background="#ccc" Margin="0,20,0,20" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="IcmpData" Content="{x:Static p:Strings.Options_PacketSize}" Name="PacketSizeOption"
                                         Checked="PacketSizeOption_Checked" IsChecked="True" MinWidth="160" VerticalAlignment="Center" />
                            <TextBox Name="PacketSize" TextChanged="PacketData_TextChanged" Width="80" MaxLength="5" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Options_Bytes}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DockPanel Margin="0,10,0,0">
                            <RadioButton GroupName="IcmpData" Content="{x:Static p:Strings.Options_CustomPacket}" Name="UseCustomPacketOption"
                                         Checked="UseCustomPacketOption_Checked" DockPanel.Dock="Left" VerticalAlignment="Top" MinWidth="160" />
                            <TextBox Name="PacketData" TextChanged="PacketData_TextChanged" Height="80" DockPanel.Dock="Right"
                                     VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" MaxLength="65500" IsVisible="False" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,15,0,0">
                            <TextBlock Foreground="#0e70c0" Text="{x:Static p:Strings.Options_TotalPacketSize}" VerticalAlignment="Center" />
                            <TextBlock Foreground="#dc322f" Name="Bytes" Margin="6,0,4,0" Text="64" VerticalAlignment="Center" />
                            <TextBlock Foreground="#dc322f" Text="{x:Static p:Strings.Options_Bytes}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Height="1" Background="#ccc" Margin="0,20,0,10" />

                        <CheckBox Name="DontFragment" Content="{x:Static p:Strings.Options_DontFragment}"
                                  ToolTip.Tip="{x:Static p:Strings.Options_DontFragmentTip}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Notifications -->
            <TabItem Header="{x:Static p:Strings.Options_TabNotifications}" Name="PopupAlertsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,15,20,15">
                        <TextBlock Text="{x:Static p:Strings.Menu_PopupAlerts}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0"
                                   ToolTip.Tip="{x:Static p:Strings.Options_PopupInfo}" />

                        <RadioButton GroupName="PopupAlerts" Content="{x:Static p:Strings.Options_PopupDisabled}" Name="PopupsDisabledOption" Margin="0,15,0,0" />
                        <RadioButton GroupName="PopupAlerts" Content="{x:Static p:Strings.Options_PopupWhenMinimized}" Name="PopupsMinimizedOption" Margin="0,6" />
                        <RadioButton GroupName="PopupAlerts" Content="{x:Static p:Strings.Options_PopupAlways}" Name="PopupsAlwaysOption" IsChecked="True" />

                        <CheckBox Name="IsAutoDismissEnabled" Content="{x:Static p:Strings.Options_AutoDismiss}" IsChecked="True" Margin="0,20,0,5"
                                  Click="IsAutoDismissEnabled_Click"
                                  ToolTip.Tip="{x:Static p:Strings.Options_AutoDismissTip}" />

                        <StackPanel Name="AutoDismissIntervalPanel" Margin="50,0,0,0" Orientation="Horizontal">
                            <TextBox Name="AutoDismissInterval" Width="60" MaxLength="2" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Options_Seconds}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Email -->
            <TabItem Header="{x:Static p:Strings.Options_TabEmail}" Name="EmailAlertsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,15,20,15">
                        <TextBlock Text="{x:Static p:Strings.Options_EmailAlerts}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" />

                        <CheckBox Name="IsEmailAlertsEnabled" Content="{x:Static p:Strings.Options_EnableEmail}" Click="IsEmailAlertsEnabled_Click"
                                  IsChecked="True" Margin="0,15,0,15"
                                  ToolTip.Tip="{x:Static p:Strings.Options_EnableEmailTip}" />

                        <StackPanel Name="EmailOptionsPanel">
                            <TextBlock Text="{x:Static p:Strings.Options_ServerInfo}" FontSize="13" FontWeight="SemiBold" Foreground="#268bd2" Margin="0,0,0,4" />

                            <Grid ColumnDefinitions="120,*" Margin="0,3,0,3">
                                <TextBlock Grid.Column="0" Text="{x:Static p:Strings.Options_SmtpServer}" />
                                <TextBox Grid.Column="1" Name="SmtpServer" />
                            </Grid>

                            <Grid ColumnDefinitions="120,Auto,*" Margin="0,3,0,3">
                                <TextBlock Grid.Column="0" Text="{x:Static p:Strings.Options_Port}" />
                                <TextBox Grid.Column="1" Name="SmtpPort" HorizontalAlignment="Left" MaxLength="5" Width="75" />
                                <CheckBox Grid.Column="2" Name="IsSmtpSslEnabled" Content="{x:Static p:Strings.Options_EnableSsl}" FontSize="13" Margin="50,0,0,0" />
                            </Grid>

                            <CheckBox Name="IsSmtpAuthenticationRequired" Content="{x:Static p:Strings.Options_RequiresAuth}"
                                      Click="IsSmtpAuthenticationRequired_Click" Foreground="#888" FontSize="13" Margin="120,8,0,3" />

                            <StackPanel Name="SmtpAuthPanel" IsVisible="False">
                                <Grid ColumnDefinitions="120,*" Margin="0,3,0,3">
                                    <TextBlock Grid.Column="0" Text="{x:Static p:Strings.Options_Username}" />
                                    <TextBox Grid.Column="1" Name="SmtpUsername" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,3,0,3">
                                    <TextBlock Grid.Column="0" Text="{x:Static p:Strings.Options_Password}" />
                                    <TextBox Grid.Column="1" Name="SmtpPassword" PasswordChar="●" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="{x:Static p:Strings.Options_EmailAddresses}" FontSize="13" FontWeight="SemiBold" Foreground="#268bd2" Margin="0,12,0,5" />

                            <Grid ColumnDefinitions="120,*" Margin="0,3,0,3">
                                <TextBlock Grid.Column="0" Text="{x:Static p:Strings.Options_Recipient}" />
                                <TextBox Grid.Column="1" Name="EmailRecipientAddress" LostFocus="EmailRecipientAddress_LostFocus" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*" Margin="0,3,0,3">
                                <TextBlock Grid.Column="0" Text="{x:Static p:Strings.Options_FromAddress}" />
                                <TextBox Grid.Column="1" Name="EmailFromAddress" />
                            </Grid>

                            <Button Name="TestEmailButton" Click="TestEmail_Click" MinWidth="85" Margin="0,18,0,0"
                                    Content="{x:Static p:Strings.Options_Test}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Sounds -->
            <TabItem Header="{x:Static p:Strings.Options_TabSounds}" Name="AudioAlertTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,15,20,15">
                        <TextBlock Text="{x:Static p:Strings.Options_AudioAlerts}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" />

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <CheckBox Name="IsAudioDownAlertEnabled" Click="IsAudioDownAlertEnabled_Click"
                                      Content="{x:Static p:Strings.Options_AudioDown}" IsChecked="True"
                                      ToolTip.Tip="{x:Static p:Strings.Options_AudioDownTip}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Name="AudioDownPanel" Margin="30,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Strings.Options_AudioPath}" />
                                <TextBox Name="AudioDownFilePath" Margin="0,4,0,8" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Click="AudioDownBrowse_Click" MinWidth="85" Content="{x:Static p:Strings.Options_Browse}" VerticalAlignment="Center" />
                                    <Button Click="AudioDownPlay_Click" MinWidth="85" Margin="10,0,0,0" Content="{x:Static p:Strings.Options_Test}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="Transparent" Margin="0,20,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <CheckBox Name="IsAudioUpAlertEnabled" Click="IsAudioUpAlertEnabled_Click"
                                      Content="{x:Static p:Strings.Options_AudioUp}" IsChecked="True"
                                      ToolTip.Tip="{x:Static p:Strings.Options_AudioUpTip}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Name="AudioUpPanel" Margin="30,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Strings.Options_AudioPath}" />
                                <TextBox Name="AudioUpFilePath" Margin="0,4,0,8" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Click="AudioUpBrowse_Click" MinWidth="85" Content="{x:Static p:Strings.Options_Browse}" VerticalAlignment="Center" />
                                    <Button Click="AudioUpPlay_Click" MinWidth="85" Margin="10,0,0,0" Content="{x:Static p:Strings.Options_Test}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Logging -->
            <TabItem Header="{x:Static p:Strings.Options_TabLogging}" Name="LogOutputTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,15,20,15">
                        <TextBlock Text="{x:Static p:Strings.Options_LogOutput}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" />

                        <CheckBox Name="IsLogOutputEnabled" Content="{x:Static p:Strings.Options_WriteLog}" IsChecked="True"
                                  Click="IsLogOutputEnabled_Click" Margin="0,15,0,0"
                                  ToolTip.Tip="{x:Static p:Strings.Options_WriteLogTip}" />
                        <Grid Name="LogOutputPanel" Margin="30,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Strings.Options_LogPath}" />
                                <TextBox Name="LogPath" Margin="0,4,0,8" />
                                <Button Click="BrowseLogPath_Click" MinWidth="85" Content="{x:Static p:Strings.Options_Browse}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="Transparent" Margin="0,20,0,0" />

                        <CheckBox Name="IsLogStatusChangesEnabled" Content="{x:Static p:Strings.Options_LogStatus}" IsChecked="True"
                                  Click="IsLogStatusChangesEnabled_Click" Margin="0,15,0,0"
                                  ToolTip.Tip="{x:Static p:Strings.Options_LogStatusTip}" />
                        <Grid Name="LogStatusChangesPanel" Margin="30,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Strings.Options_LogStatusPath}" />
                                <TextBox Name="LogStatusChangesPath" Margin="0,4,0,8" />
                                <Button Click="BrowseLogStatusChangesPath_Click" MinWidth="85" Content="{x:Static p:Strings.Options_Browse}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Display -->
            <TabItem Header="{x:Static p:Strings.Options_TabDisplay}" Name="DisplayTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,15,20,15">
                        <TextBlock Text="{x:Static p:Strings.Options_DisplayOptions}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" />

                        <CheckBox Name="IsAlwaysOnTopEnabled" Content="{x:Static p:Strings.Options_AlwaysOnTop}" Margin="0,15,0,0"
                                  ToolTip.Tip="{x:Static p:Strings.Options_AlwaysOnTopTip}" />
                        <CheckBox Name="IsMinimizeToTrayEnabled" Content="{x:Static p:Strings.Options_MinimizeToTray}" Margin="0,15,0,0"
                                  ToolTip.Tip="{x:Static p:Strings.Options_MinimizeToTrayTip}" />
                        <CheckBox Name="IsExitToTrayEnabled" Content="{x:Static p:Strings.Options_ExitToTray}" Margin="0,15,0,0"
                                  ToolTip.Tip="{x:Static p:Strings.Options_ExitToTrayTip}" />

                        <!-- i18n (FASE 5): seletor de idioma. Os itens são
                             populados no code-behind (PopulateDisplayOptions) —
                             rótulos via resx, valores via Tag implícita por
                             índice (0=auto, 1=en-US, 2=pt-BR; ver
                             LanguageIndexToCode no code-behind). -->
                        <TextBlock Name="LanguageLabel" Text="{x:Static p:Strings.Options_Language}" Margin="0,25,0,5" />
                        <ComboBox Name="LanguageCombo" Width="240" HorizontalAlignment="Left" />
                        <TextBlock Name="LanguageRestartNote" Text="{x:Static p:Strings.Options_LanguageRestart}"
                                   Margin="0,6,0,0" FontSize="12" Foreground="#777" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Colors -->
            <TabItem Header="{x:Static p:Strings.Options_TabColors}" Name="LayoutTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ColorsPanel" Margin="20,15,20,20">
                        <TextBlock Text="{x:Static p:Strings.Options_TabColors}" FontSize="16" FontWeight="SemiBold" Foreground="#0e70c0" />

                        <TextBlock Text="{x:Static p:Strings.Options_ProbeBackground}" FontSize="13" FontWeight="SemiBold" Foreground="#268bd2" Margin="0,15,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorInactive}" VerticalAlignment="Center" /><TextBox Name="BackgroundColor_Probe_Inactive" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorUp}" VerticalAlignment="Center" /><TextBox Name="BackgroundColor_Probe_Up" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorDown}" VerticalAlignment="Center" /><TextBox Name="BackgroundColor_Probe_Down" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorIndeterminate}" VerticalAlignment="Center" /><TextBox Name="BackgroundColor_Probe_Indeterminate" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorError}" VerticalAlignment="Center" /><TextBox Name="BackgroundColor_Probe_Error" Width="120" VerticalAlignment="Center" /></StackPanel>

                        <TextBlock Text="{x:Static p:Strings.Options_ProbeForeground}" FontSize="13" FontWeight="SemiBold" Foreground="#268bd2" Margin="0,20,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorInactive}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Probe_Inactive" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorUp}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Probe_Up" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorDown}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Probe_Down" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorIndeterminate}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Probe_Indeterminate" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorError}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Probe_Error" Width="120" VerticalAlignment="Center" /></StackPanel>

                        <TextBlock Text="{x:Static p:Strings.Options_StatsForeground}" FontSize="13" FontWeight="SemiBold" Foreground="#268bd2" Margin="0,20,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorInactive}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Stats_Inactive" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorUp}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Stats_Up" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorDown}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Stats_Down" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorIndeterminate}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Stats_Indeterminate" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorError}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Stats_Error" Width="120" VerticalAlignment="Center" /></StackPanel>

                        <TextBlock Text="{x:Static p:Strings.Options_AliasForeground}" FontSize="13" FontWeight="SemiBold" Foreground="#268bd2" Margin="0,20,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorInactive}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Alias_Inactive" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorUp}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Alias_Up" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorDown}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Alias_Down" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorIndeterminate}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Alias_Indeterminate" Width="120" VerticalAlignment="Center" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10"><TextBlock MinWidth="150" Text="{x:Static p:Strings.Options_ColorError}" VerticalAlignment="Center" /><TextBox Name="ForegroundColor_Alias_Error" Width="120" VerticalAlignment="Center" /></StackPanel>

                        <Button Click="RestoreDefaultColors_Click" Padding="15,5" Content="{x:Static p:Strings.Options_RestoreDefaults}" HorizontalAlignment="Left" Margin="0,15,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Button section -->
        <Border Grid.Row="1" BorderBrush="#dfdfdf" Background="#f0f0f0" BorderThickness="0,1,0,0">
            <DockPanel Margin="9" HorizontalAlignment="Right">
                <CheckBox DockPanel.Dock="Top" Name="SaveAsDefaults" Content="{x:Static p:Strings.Options_SaveAsDefaults}"
                          FontSize="13" Foreground="#111" HorizontalAlignment="Right" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,9,0,0" HorizontalAlignment="Right">
                    <Button Click="OK_Click" Margin="0,0,9,0" IsDefault="True" MinWidth="85" Content="{x:Static p:Strings.DialogButton_OK}" VerticalAlignment="Center" />
                    <Button Click="Cancel_Click" MinWidth="85" Content="{x:Static p:Strings.DialogButton_Cancel}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
